{
  "name": "paperpilot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:bank": "node scripts/validate-bank.js",
    "draft-questions": "node scripts/draft-questions.js",
    "approve-questions": "node scripts/approve.js",
    "sample-paper": "node scripts/generate-sample-paper.mjs"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "supertest": "^7.1.4",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
